@prefix : <http://maia.madrid.es/ontologies/def/local-regulations#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@base <http://maia.madrid.es/ontologies/def/local-regulations#> .

<http://maia.madrid.es/ontologies/def/local-regulations> rdf:type owl:Ontology ;
                                                          owl:versionIRI <http://maia.madrid.es/ontologies/def/local-regulations/1.0> ;
                                                          <http://purl.org/dc/terms/contributor> "GNOSS" ;
                                                          <http://purl.org/dc/terms/created> "2026-01-30"^^xsd:date ;
                                                          <http://purl.org/dc/terms/creator> "Ayuntamiento de Madrid" ;
                                                          <http://purl.org/dc/terms/license> <https://creativecommons.org/licenses/by/4.0/> ;
                                                          <http://purl.org/dc/terms/description> "LoRO extends the ELI ontology to represent local regulations, authorities, agents and events for local governments, including legal resources, subdivisions, formats, authorities and public offices."@en ,
                                                                                                 "LoRO extiende la ontología ELI para representar normativa, competencias, agentes y eventos locales de gobiernos locales, incluyendo recursos legales, subdivisiones, formatos, competencias y cargos públicos."@es ;
                                                          <http://purl.org/dc/terms/publisher> "Ayuntamiento de Madrid" ;
                                                          <http://purl.org/dc/terms/title> "Local Regulation Ontology (LoRO)" ;
                                                          <http://purl.org/vocab/vann/preferredNamespacePrefix> "loro" ;
                                                          <http://purl.org/vocab/vann/preferredNamespaceUri> "http://maia.madrid.es/ontologies/def/local-regulations#" ;
                                                          rdfs:comment "Esta ontología proporciona un marco integral para representar normativa local, competencias jurídicas, estructuras organizativas y procesos administrativos específicos de entidades de gobierno local. Extiende la ontología European Legislation Identifier (ELI) con conceptos de gobierno local."@es ,
                                                                       "This ontology provides a comprehensive framework for representing local regulations, legal authorities, organizational structures, and administrative processes specific to local government entities. It extends the European Legislation Identifier (ELI) ontology with local government concepts."@en ;
                                                          rdfs:label "Local Regulation Ontology"@en ,
                                                                     "Ontología de Regulación Local"@es ;
                                                          owl:versionInfo "1.0" .

#################################################################
#    Annotation properties
#################################################################

###  http://purl.org/dc/terms/contributor
<http://purl.org/dc/terms/contributor> rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/created
<http://purl.org/dc/terms/created> rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/creator
<http://purl.org/dc/terms/creator> rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/description
<http://purl.org/dc/terms/description> rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/publisher
<http://purl.org/dc/terms/publisher> rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/title
<http://purl.org/dc/terms/title> rdf:type owl:AnnotationProperty .


###  http://purl.org/vocab/vann/preferredNamespacePrefix
<http://purl.org/vocab/vann/preferredNamespacePrefix> rdf:type owl:AnnotationProperty .


###  http://purl.org/vocab/vann/preferredNamespaceUri
<http://purl.org/vocab/vann/preferredNamespaceUri> rdf:type owl:AnnotationProperty .


###  http://schema.org/name
<http://schema.org/name> rdf:type owl:AnnotationProperty ;
                         rdfs:range xsd:string .


#################################################################
#    Datatypes
#################################################################

###  http://www.w3.org/2001/XMLSchema#date
xsd:date rdf:type rdfs:Datatype .


#################################################################
#    Object Properties
#################################################################

###  http://data.europa.eu/eli/ontology#amended_by
<http://data.europa.eu/eli/ontology#amended_by> rdf:type owl:ObjectProperty ;
                                                rdfs:domain <http://data.europa.eu/eli/ontology#LegalResourceSubdivision> ;
                                                rdfs:range <http://data.europa.eu/eli/ontology#LegalResource> ;
                                                rdfs:comment "Indica que un recurso legal es enmendado o modificado parcialmente por otro recurso legal."@es ,
                                                             "Indicates that a legal resource is amended or partially modified by another legal resource."@en ;
                                                rdfs:label "amended by (ELI)"@en ,
                                                           "enmendado por (ELI)"@es .


###  http://data.europa.eu/eli/ontology#amends
<http://data.europa.eu/eli/ontology#amends> rdf:type owl:ObjectProperty ;
                                            rdfs:domain <http://data.europa.eu/eli/ontology#LegalResource> ;
                                            rdfs:range <http://data.europa.eu/eli/ontology#LegalResourceSubdivision> ;
                                            rdfs:comment "Indica que un recurso legal enmienda o modifica parcialmente otro recurso legal o subdivisión legal."@es ,
                                                         "Indicates that a legal resource amends or partially modifies another legal resource or subdivision."@en ;
                                            rdfs:label "amends (ELI)"@en ,
                                                       "enmienda (ELI)"@es .


###  http://data.europa.eu/eli/ontology#changed_by
<http://data.europa.eu/eli/ontology#changed_by> rdf:type owl:ObjectProperty ;
                                                rdfs:domain <http://data.europa.eu/eli/ontology#LegalResourceSubdivision> ;
                                                rdfs:range <http://data.europa.eu/eli/ontology#LegalResource> ;
                                                rdfs:comment "Indica que un recurso legal es modificado o alterado por otro recurso legal."@es ,
                                                             "Indicates that a legal resource is changed or altered by another legal resource."@en ;
                                                rdfs:label "changed by (ELI)"@en ,
                                                           "modificado por (ELI)"@es .


###  http://data.europa.eu/eli/ontology#changes
<http://data.europa.eu/eli/ontology#changes> rdf:type owl:ObjectProperty ;
                                             rdfs:domain <http://data.europa.eu/eli/ontology#LegalResource> ;
                                             rdfs:range <http://data.europa.eu/eli/ontology#LegalResourceSubdivision> ;
                                             rdfs:comment "Indica que un recurso legal modifica o altera otro recurso legal o subdivisión legal."@es ,
                                                          "Indicates that a legal resource changes or alters another legal resource or subdivision."@en ;
                                             rdfs:label "changes (ELI)"@en ,
                                                        "modifica (ELI)"@es .


###  http://data.europa.eu/eli/ontology#consolidates
<http://data.europa.eu/eli/ontology#consolidates> rdf:type owl:ObjectProperty ;
                                                  rdfs:domain <http://data.europa.eu/eli/ontology#LegalResource> ;
                                                  rdfs:range <http://data.europa.eu/eli/ontology#LegalResource> ;
                                                  rdfs:comment "Property consolidates from external vocabulary"@en ,
                                                               "Propiedad consolidates de vocabulario externo"@es ;
                                                  rdfs:label "Consolida"@es ,
                                                             "consolidates (ELI)"@en .


###  http://data.europa.eu/eli/ontology#has_annex
<http://data.europa.eu/eli/ontology#has_annex> rdf:type owl:ObjectProperty ;
                                               rdfs:domain <http://data.europa.eu/eli/ontology#LegalResource> ;
                                               rdfs:range :LegalResourceSubsivision ;
                                               rdfs:comment "Property has_annex from external vocabulary"@en ,
                                                            "Propiedad has_annex de vocabulario externo"@es ;
                                               rdfs:label "Anexos"@es ,
                                                          "has annex (ELI)"@en .


###  http://data.europa.eu/eli/ontology#has_part
<http://data.europa.eu/eli/ontology#has_part> rdf:type owl:ObjectProperty ;
                                              rdfs:domain [ rdf:type owl:Class ;
                                                            owl:unionOf ( <http://data.europa.eu/eli/ontology#LegalResource>
                                                                          <http://data.europa.eu/eli/ontology#LegalResourceSubdivision>
                                                                        )
                                                          ] ;
                                              rdfs:range <http://data.europa.eu/eli/ontology#LegalResourceSubdivision> ;
                                              rdfs:comment "Property has_part from external vocabulary"@en ,
                                                           "Propiedad has_part de vocabulario externo"@es ;
                                              rdfs:label "Partes/capítulos/artículos"@es ,
                                                         "has part (ELI)"@en .


###  http://data.europa.eu/eli/ontology#is_about
<http://data.europa.eu/eli/ontology#is_about> rdf:type owl:ObjectProperty ;
                                              rdfs:domain <http://data.europa.eu/eli/ontology#LegalResource> ;
                                              rdfs:range :IsAboutPath ;
                                              rdfs:comment "Property is_about from external vocabulary"@en ,
                                                           "Propiedad is_about de vocabulario externo"@es ;
                                              rdfs:label "Materias/Temas"@es ,
                                                         "is about (ELI)"@en .


###  http://data.europa.eu/eli/ontology#is_embodied_by
<http://data.europa.eu/eli/ontology#is_embodied_by> rdf:type owl:ObjectProperty ;
                                                    rdfs:domain <http://data.europa.eu/eli/ontology#LegalExpression> ;
                                                    rdfs:range :Format ;
                                                    rdfs:comment "Es materializado por"@es ,
                                                                 "Is embodied by"@en ;
                                                    rdfs:label "es materializado por (ELI)"@es ,
                                                               "is embodied by (ELI)"@en .


###  http://data.europa.eu/eli/ontology#is_part_of
<http://data.europa.eu/eli/ontology#is_part_of> rdf:type owl:ObjectProperty ;
                                                owl:inverseOf <http://data.europa.eu/eli/ontology#has_part> ;
                                                rdfs:domain <http://data.europa.eu/eli/ontology#LegalResourceSubdivision> ;
                                                rdfs:range [ rdf:type owl:Class ;
                                                             owl:unionOf ( <http://data.europa.eu/eli/ontology#LegalResource>
                                                                           <http://data.europa.eu/eli/ontology#LegalResourceSubdivision>
                                                                         )
                                                           ] ;
                                                rdfs:comment "Property is_part_of from external vocabulary"@en ,
                                                             "Propiedad is_part_of de vocabulario externo"@es ;
                                                rdfs:label "Es parte de"@es ,
                                                           "is part of (ELI)"@en .


###  http://data.europa.eu/eli/ontology#is_realized_by
<http://data.europa.eu/eli/ontology#is_realized_by> rdf:type owl:ObjectProperty ;
                                                    rdfs:domain <http://data.europa.eu/eli/ontology#LegalResourceSubdivision> ;
                                                    rdfs:range <http://data.europa.eu/eli/ontology#LegalExpression> ;
                                                    rdfs:comment "Es realizado por"@es ,
                                                                 "Is realized by"@en ;
                                                    rdfs:label "es realizado por (ELI)"@es ,
                                                               "is realized by (ELI)"@en .


###  http://data.europa.eu/eli/ontology#legal_value
<http://data.europa.eu/eli/ontology#legal_value> rdf:type owl:ObjectProperty ;
                                                 rdfs:domain <http://data.europa.eu/eli/ontology#LegalExpression> ;
                                                 rdfs:range :LegalValue ;
                                                 rdfs:comment "Legal value"@en ,
                                                              "Valor legal"@es ;
                                                 rdfs:label "legal value (ELI)"@en ,
                                                            "valor legal (ELI)"@es .


###  http://data.europa.eu/eli/ontology#passed_by
<http://data.europa.eu/eli/ontology#passed_by> rdf:type owl:ObjectProperty ;
                                               owl:inverseOf <http://maia.madrid.es/ontologies/def/passes_norm> ;
                                               rdfs:domain <http://data.europa.eu/eli/ontology#LegalResource> ;
                                               rdfs:range <http://xmlns.com/foaf/0.1/Agent> ;
                                               rdfs:comment "Aprobado por"@es ,
                                                            "Passed by"@en ;
                                               rdfs:label "aprobado por (ELI)"@es ,
                                                          "passed by (ELI)"@en .


###  http://data.europa.eu/eli/ontology#realizes
<http://data.europa.eu/eli/ontology#realizes> rdf:type owl:ObjectProperty ;
                                              rdfs:domain <http://data.europa.eu/eli/ontology#LegalExpression> ;
                                              rdfs:range <http://data.europa.eu/eli/ontology#LegalResourceSubdivision> ;
                                              rdfs:comment "Realiza"@es ,
                                                           "Realizes"@en ;
                                              rdfs:label "realiza (ELI)"@es ,
                                                         "realizes (ELI)"@en .


###  http://data.europa.eu/eli/ontology#refers_to
<http://data.europa.eu/eli/ontology#refers_to> rdf:type owl:ObjectProperty ;
                                               owl:inverseOf :associated_norm ;
                                               rdfs:domain <http://data.europa.eu/eli/ontology#LegalResource> ;
                                               rdfs:range <http://xmlns.com/foaf/0.1/Agent> ;
                                               rdfs:comment "Refers to"@en ,
                                                            "Refiere a"@es ;
                                               rdfs:label "refers to (ELI)"@en ,
                                                          "refiere a (ELI)"@es .


###  http://data.europa.eu/eli/ontology#relevant_for
<http://data.europa.eu/eli/ontology#relevant_for> rdf:type owl:ObjectProperty ;
                                                  rdfs:domain :LegalResource ;
                                                  rdfs:range :Feature ;
                                                  rdfs:comment "Property relevant_for from external vocabulary"@en ,
                                                               "Propiedad relevant_for de vocabulario externo"@es ;
                                                  rdfs:label "Lugar relevante"@es ,
                                                             "relevant for (ELI)"@en .


###  http://data.europa.eu/eli/ontology#repealed_by
<http://data.europa.eu/eli/ontology#repealed_by> rdf:type owl:ObjectProperty ;
                                                 rdfs:domain <http://data.europa.eu/eli/ontology#LegalResourceSubdivision> ;
                                                 rdfs:range <http://data.europa.eu/eli/ontology#LegalResource> ;
                                                 rdfs:comment "Indica que un recurso legal es derogado total o parcialmente por otro recurso legal."@es ,
                                                              "Indicates that a legal resource is repealed totally or partially by another legal resource."@en ;
                                                 rdfs:label "derogado por (ELI)"@es ,
                                                            "repealed by (ELI)"@en .


###  http://data.europa.eu/eli/ontology#repeals
<http://data.europa.eu/eli/ontology#repeals> rdf:type owl:ObjectProperty ;
                                             rdfs:domain <http://data.europa.eu/eli/ontology#LegalResource> ;
                                             rdfs:range <http://data.europa.eu/eli/ontology#LegalResourceSubdivision> ;
                                             rdfs:comment "Indica que un recurso legal deroga total o parcialmente otro recurso legal o subdivisión legal."@es ,
                                                          "Indicates that a legal resource repeals totally or partially another legal resource or subdivision."@en ;
                                             rdfs:label "deroga (ELI)"@es ,
                                                        "repeals (ELI)"@en .


###  http://data.europa.eu/eli/ontology#type_document
<http://data.europa.eu/eli/ontology#type_document> rdf:type owl:ObjectProperty ;
                                                   rdfs:domain <http://data.europa.eu/eli/ontology#LegalResource> ;
                                                   rdfs:range :TypeDocumentPath ;
                                                   rdfs:comment "Property type_document from external vocabulary"@en ,
                                                                "Propiedad type_document de vocabulario externo"@es ;
                                                   rdfs:label "Tipo documental"@es ,
                                                              "type document (ELI)"@en .


###  http://maia.madrid.es/ontologies/def/associated_norm
<http://maia.madrid.es/ontologies/def/associated_norm> rdf:type owl:ObjectProperty ;
                                                       owl:inverseOf <http://data.europa.eu/eli/ontology#refers_to> ;
                                                       rdfs:domain <http://xmlns.com/foaf/0.1/Agent> ;
                                                       rdfs:range <http://data.europa.eu/eli/ontology#LegalResource> ;
                                                       rdfs:comment "Asocia un agente con recursos legales relevantes para su actividad o que se encuentran dentro de su ámbito de actuación."@es ,
                                                                    "Associates an agent with legal resources that are relevant to its activity or within its scope of action."@en ;
                                                       rdfs:label "associated legal resource"@en ,
                                                                  "norma asociada"@es .


###  http://maia.madrid.es/ontologies/def/passes_norm
<http://maia.madrid.es/ontologies/def/passes_norm> rdf:type owl:ObjectProperty .


###  http://maia.madrid.es/ontologies/def/local-regulations#associated_norm
:associated_norm rdf:type owl:ObjectProperty .


###  http://maia.madrid.es/ontologies/def/local-regulations#hasMembership
:hasMembership rdf:type owl:ObjectProperty ;
               rdfs:domain :Person ;
               rdfs:range <http://www.w3.org/ns/org#Membership> ;
               rdfs:comment "Links a person to their membership in a public office within an organization."@en ,
                            "Vincula una persona con su membresía en un cargo público dentro de una organización."@es ;
               rdfs:label "has membership"@en ,
                          "tiene membresía"@es .


###  http://maia.madrid.es/ontologies/def/local-regulations#implements_competence
:implements_competence rdf:type owl:ObjectProperty ;
                       rdfs:domain :LegalResource ;
                       rdfs:range :LegalCompetencePath ;
                       rdfs:comment "Asocia un recurso legal con las competencias que implementa."@es ,
                                    "Links a legal resource with the authorities it implements."@en ;
                       rdfs:label "implementa competencia"@es ,
                                  "implements authority"@en .


###  http://maia.madrid.es/ontologies/def/local-regulations#isAboutNode
:isAboutNode rdf:type owl:ObjectProperty ;
             rdfs:domain :IsAboutPath ;
             rdfs:range <http://www.w3.org/2008/05/skos#Concept> ;
             rdfs:comment "Links a subject matter path to a specific SKOS concept node that represents a subject in the hierarchy."@en ,
                          "Vincula una ruta de materias con un nodo de concepto SKOS específico que representa una materia en la jerarquía."@es ;
             rdfs:label "is about node"@en ,
                        "nodo materias"@es .


###  http://maia.madrid.es/ontologies/def/local-regulations#legalCompetenceNode
:legalCompetenceNode rdf:type owl:ObjectProperty ;
                     rdfs:domain :LegalCompetencePath ;
                     rdfs:range <http://www.w3.org/2008/05/skos#Concept> ;
                     rdfs:comment "Links an authority path to a specific SKOS concept node that represents an authority in the hierarchy."@en ,
                                  "Vincula una ruta de competencia con un nodo de concepto SKOS específico que representa una competencia en la jerarquía."@es ;
                     rdfs:label "legal authority node"@en ,
                                "nodo competencia legal"@es .


###  http://maia.madrid.es/ontologies/def/local-regulations#passed_by_organization
:passed_by_organization rdf:type owl:ObjectProperty ;
                        rdfs:subPropertyOf <http://data.europa.eu/eli/ontology#passed_by> ;
                        rdfs:domain :LegalResource ;
                        rdfs:range <http://www.w3.org/ns/org#Organization> ;
                        rdfs:comment "Indica que un recurso legal ha sido aprobado por una organización."@es ,
                                     "Indicates that a legal resource has been passed by an organization."@en ;
                        rdfs:label "aprobado por organización"@es ,
                                   "passed by organization"@en .


###  http://maia.madrid.es/ontologies/def/local-regulations#passed_by_person
:passed_by_person rdf:type owl:ObjectProperty ;
                  rdfs:subPropertyOf <http://data.europa.eu/eli/ontology#passed_by> ;
                  rdfs:domain :LegalResource ;
                  rdfs:range <http://xmlns.com/foaf/0.1/Agent> ;
                  rdfs:comment "Indica que un recurso legal ha sido aprobado por una persona o agente."@es ,
                               "Indicates that a legal resource has been passed by a person or agent."@en ;
                  rdfs:label "aprobado por persona"@es ,
                             "passed by person"@en .


###  http://maia.madrid.es/ontologies/def/local-regulations#passes_norm
:passes_norm rdf:type owl:ObjectProperty ;
             owl:inverseOf <http://data.europa.eu/eli/ontology#passed_by> ;
             rdfs:domain <http://xmlns.com/foaf/0.1/Agent> ;
             rdfs:range <http://data.europa.eu/eli/ontology#LegalResource> ;
             rdfs:comment "Indica que un agente (por ejemplo, un órgano colegiado) aprueba formalmente un recurso legal."@es ,
                          "Indicates that an agent (e.g. a collegiate body) formally passes or adopts a legal resource."@en ;
             rdfs:label "aprueba norma"@es ,
                        "passes legal resource"@en .


###  http://maia.madrid.es/ontologies/def/local-regulations#refers_to_organization
:refers_to_organization rdf:type owl:ObjectProperty ;
                        rdfs:subPropertyOf <http://data.europa.eu/eli/ontology#refers_to> ;
                        rdfs:domain :LegalResource ;
                        rdfs:range <http://xmlns.com/foaf/0.1/Agent> ;
                        rdfs:comment "Indica que un recurso legal hace referencia a una organización específica."@es ,
                                     "Indicates that a legal resource refers to a specific organization."@en ;
                        rdfs:label "refers to organization"@en ,
                                   "se refiere a organización"@es .


###  http://maia.madrid.es/ontologies/def/local-regulations#refers_to_person
:refers_to_person rdf:type owl:ObjectProperty ;
                  rdfs:subPropertyOf <http://data.europa.eu/eli/ontology#refers_to> ;
                  rdfs:domain :LegalResource ;
                  rdfs:range <http://xmlns.com/foaf/0.1/Agent> ;
                  rdfs:comment "Indica que un recurso legal hace referencia a una persona o agente específico."@es ,
                               "Indicates that a legal resource refers to a specific person or agent."@en ;
                  rdfs:label "refers to person"@en ,
                             "se refiere a persona"@es .


###  http://maia.madrid.es/ontologies/def/local-regulations#relevantEvent
:relevantEvent rdf:type owl:ObjectProperty ;
               rdfs:domain :LegalResourceSubsivision ;
               rdfs:range <http://schema.org/Event> ;
               rdfs:comment "Relaciona un recurso legal o una subdivisión con eventos (temporales, fiestas, obras, emergencias, etc.) mencionados en el texto y relevantes para su aplicabilidad."@es ,
                            "Relates a legal resource or subdivision with events (storms, festivities, works, emergencies, etc.) mentioned in the text and relevant for its applicability."@en ;
               rdfs:label "evento relevante"@es ,
                          "relevant event"@en .


###  http://maia.madrid.es/ontologies/def/local-regulations#temaNode
:temaNode rdf:type owl:ObjectProperty ;
          rdfs:domain :TopicPath ;
          rdfs:range <http://www.w3.org/2008/05/skos#Concept> ;
          rdfs:comment "Links a topic path to a specific SKOS concept node that represents a topic in the hierarchy."@en ,
                       "Vincula una ruta de tema con un nodo de concepto SKOS específico que representa un tema en la jerarquía."@es ;
          rdfs:label "nodo tema"@es ,
                     "topic node"@en .


###  http://maia.madrid.es/ontologies/def/local-regulations#topic
:topic rdf:type owl:ObjectProperty ;
       rdfs:domain :LegalResource ;
       rdfs:range :TopicPath ;
       rdfs:comment "Asocia un recurso legal con conceptos temáticos."@es ,
                    "Associates a legal resource with topic concepts."@en ;
       rdfs:label "tema"@es ,
                  "topic"@en .


###  http://maia.madrid.es/ontologies/def/local-regulations#typeDocumentNode
:typeDocumentNode rdf:type owl:ObjectProperty ;
                  rdfs:domain :TypeDocumentPath ;
                  rdfs:range <http://www.w3.org/2008/05/skos#Concept> ;
                  rdfs:comment "Links a document type path to a specific SKOS concept node that represents a document type in the hierarchy."@en ,
                               "Vincula una ruta de tipo documental con un nodo de concepto SKOS específico que representa un tipo documental en la jerarquía."@es ;
                  rdfs:label "nodo tipo documental"@es ,
                             "type document node"@en .


###  http://www.w3.org/2006/time#hasTime
<http://www.w3.org/2006/time#hasTime> rdf:type owl:ObjectProperty ;
                                      rdfs:domain <http://schema.org/Event> ;
                                      rdfs:range <http://www.w3.org/2006/time#Interval> ;
                                      rdfs:comment "Has time"@en ,
                                                   "Tiene tiempo"@es ;
                                      rdfs:label "has time"@en ,
                                                 "tiene tiempo"@es .


###  http://www.w3.org/2008/05/skos#broader
<http://www.w3.org/2008/05/skos#broader> rdf:type owl:ObjectProperty ;
                                         rdfs:domain <http://www.w3.org/2008/05/skos#Concept> ;
                                         rdfs:range <http://www.w3.org/2008/05/skos#Concept> ;
                                         rdfs:comment "Property broader from external vocabulary"@en ,
                                                      "Propiedad broader de vocabulario externo"@es ;
                                         rdfs:label "broader (SKOS)"@en ,
                                                    "más amplio (SKOS)"@es .


###  http://www.w3.org/2008/05/skos#member
<http://www.w3.org/2008/05/skos#member> rdf:type owl:ObjectProperty ;
                                        rdfs:domain <http://www.w3.org/2008/05/skos#Collection> ;
