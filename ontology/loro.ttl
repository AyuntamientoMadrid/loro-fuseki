###  http://data.europa.eu/eli/ontology#Format
<http://data.europa.eu/eli/ontology#Format> rdf:type owl:Class ;
                                            rdfs:subClassOf owl:Thing ,
                                                            [ rdf:type owl:Restriction ;
                                                              owl:onProperty <http://data.europa.eu/eli/ontology#format> ;
                                                              owl:cardinality "1"^^xsd:nonNegativeInteger
                                                            ] ;
                                            rdfs:comment "A format of a legal expression, such as PDF, HTML, or printed document."@en ,
                                                         "Un formato de una expresión legal, como PDF, HTML o documento impreso."@es ;
                                            rdfs:label "Format (ELI)"@en ,
                                                       "Formato (ELI)"@es .


###  http://data.europa.eu/eli/ontology#LegalExpression
<http://data.europa.eu/eli/ontology#LegalExpression> rdf:type owl:Class ;
                                                     rdfs:subClassOf [ rdf:type owl:Restriction ;
                                                                       owl:onProperty <http://data.europa.eu/eli/ontology#legal_value> ;
                                                                       owl:cardinality "1"^^xsd:nonNegativeInteger
                                                                     ] ,
                                                                     [ rdf:type owl:Restriction ;
                                                                       owl:onProperty <http://data.europa.eu/eli/ontology#realizes> ;
                                                                       owl:cardinality "1"^^xsd:nonNegativeInteger
                                                                     ] ;
                                                     rdfs:comment "A specific linguistic expression of a legal resource, representing the text in a particular language."@en ,
                                                                  "Una expresión lingüística específica de un recurso legal, que representa el texto en un idioma particular."@es ;
                                                     rdfs:label "Expresión Legal (ELI)"@es ,
                                                                "Legal Expression (ELI)"@en .


###  http://data.europa.eu/eli/ontology#LegalResource
<http://data.europa.eu/eli/ontology#LegalResource> rdf:type owl:Class ;
                                                   rdfs:subClassOf owl:Thing ,
                                                                   [ rdf:type owl:Restriction ;
                                                                     owl:onProperty <http://data.europa.eu/eli/ontology#number> ;
                                                                     owl:cardinality "1"^^xsd:nonNegativeInteger
                                                                   ] ;
                                                   rdfs:comment "A work, in the sense of FRBR, corresponding to the abstract concept of a legal resource."@en ,
                                                                "Una obra, en el sentido de FRBR, que corresponde al concepto abstracto de un recurso legal."@es ;
                                                   rdfs:label "Legal Resource (ELI)"@en ,
                                                              "Recurso Legal (ELI)"@es .


###  http://data.europa.eu/eli/ontology#LegalResourceSubdivision
<http://data.europa.eu/eli/ontology#LegalResourceSubdivision> rdf:type owl:Class ;
                                                              rdfs:subClassOf owl:Thing ,
                                                                              [ rdf:type owl:Restriction ;
                                                                                owl:onProperty <http://data.europa.eu/eli/ontology#date_applicability> ;
                                                                                owl:maxCardinality "1"^^xsd:nonNegativeInteger
                                                                              ] ,
                                                                              [ rdf:type owl:Restriction ;
                                                                                owl:onProperty <http://data.europa.eu/eli/ontology#date_no_longer_in_force> ;
                                                                                owl:maxCardinality "1"^^xsd:nonNegativeInteger
                                                                              ] ,
                                                                              [ rdf:type owl:Restriction ;
                                                                                owl:onProperty <http://data.europa.eu/eli/ontology#first_date_entry_in_force> ;
                                                                                owl:maxCardinality "1"^^xsd:nonNegativeInteger
                                                                              ] ;
                                                              rdfs:comment "A subdivision of a legal resource, such as an article, chapter, or section."@en ,
                                                                           "Una subdivisión de un recurso legal, como un artículo, capítulo o sección."@es ;
                                                              rdfs:label "Legal Resource Subdivision (ELI)"@en ,
                                                                         "Subdivisión de Recurso Legal (ELI)"@es .


###  http://data.europa.eu/eli/ontology#ResourceType
<http://data.europa.eu/eli/ontology#ResourceType> rdf:type owl:Class .


###  http://maia.madrid.es/ontologies/def/local-regulations#Feature
:Feature rdf:type owl:Class ;
         rdfs:subClassOf <https://www.geonames.org/ontology#Feature> ,
                         [ rdf:type owl:Restriction ;
                           owl:onProperty <http://purl.org/dc/elements/1.1/identifier> ;
                           owl:cardinality "1"^^xsd:nonNegativeInteger
                         ] ,
                         [ rdf:type owl:Restriction ;
                           owl:onProperty <http://purl.org/dc/elements/1.1/description> ;
                           owl:maxCardinality "1"^^xsd:nonNegativeInteger
                         ] ,
                         [ rdf:type owl:Restriction ;
                           owl:onProperty <http://www.w3.org/2003/01/geo/wgs84_pos#lat> ;
                           owl:maxCardinality "1"^^xsd:nonNegativeInteger
                         ] ,
                         [ rdf:type owl:Restriction ;
                           owl:onProperty <http://www.w3.org/2003/01/geo/wgs84_pos#long> ;
                           owl:maxCardinality "1"^^xsd:nonNegativeInteger
                         ] ,
                         [ rdf:type owl:Restriction ;
                           owl:onProperty <https://www.geonames.org/ontology#geonameId> ;
                           owl:maxCardinality "1"^^xsd:nonNegativeInteger
                         ] ;
         rdfs:comment "Entidad geográfica o ubicación con coordenadas e identificación, que representa un lugar en una localidad."@es ,
                      "Geographical entity or location with coordinates and identification, typically representing a place in a locality."@en ;
         rdfs:label "Entidad geográfica"@es ,
                    "Feature"@en .


###  http://maia.madrid.es/ontologies/def/local-regulations#Format
:Format rdf:type owl:Class ;
        rdfs:subClassOf <http://data.europa.eu/eli/ontology#Format> ;
        rdfs:comment "Formato físico o electrónico de un recurso legal (PDF, HTML, etc.)."@es ,
                     "Physical or electronic format of a legal resource (PDF, HTML, etc.)."@en ;
        rdfs:label "Format"@en ,
                   "Formato"@es .


###  http://maia.madrid.es/ontologies/def/local-regulations#IsAboutPath
:IsAboutPath rdf:type owl:Class ;
             rdfs:subClassOf <http://www.w3.org/2008/05/skos#Concept> ;
             rdfs:comment "Hierarchical classification path for subject matters that legal resources address."@en ,
                          "Ruta de clasificación jerárquica para las materias que abordan los recursos legales."@es ;
             rdfs:label "Is About Path"@en ,
                        "Ruta de Materias"@es .


###  http://maia.madrid.es/ontologies/def/local-regulations#LegalCompetencePath
:LegalCompetencePath rdf:type owl:Class ;
                     rdfs:comment "Hierarchical path or sequence that represents the delegation or assignment of authorities within the public administration structure."@en ,
                                  "Ruta jerárquica o secuencia que representa la delegación o asignación de competencias dentro de la estructura de la administración pública."@es ;
                     rdfs:label "Legal Authority Path"@en ,
                                "Ruta de Competencia Legal"@es .


###  http://maia.madrid.es/ontologies/def/local-regulations#LegalResource
:LegalResource rdf:type owl:Class ;
               rdfs:subClassOf <http://data.europa.eu/eli/ontology#LegalResource> ;
               rdfs:comment "Extension of ELI LegalResource for specific needs of local legal framework."@en ,
                            "Extensión de ELI LegalResource para necesidades específicas del marco legal local."@es ;
               rdfs:label "Extensión de Recurso Legal"@es ,
                          "Legal Resource Extension"@en .


###  http://maia.madrid.es/ontologies/def/local-regulations#LegalResourceSubsivision
:LegalResourceSubsivision rdf:type owl:Class ;
                          rdfs:subClassOf <http://data.europa.eu/eli/ontology#LegalResourceSubdivision> ;
                          rdfs:comment "Extension of ELI LegalResourceSubdivision for specific needs of local legal resources."@en ,
                                       "Extensión de ELI LegalResourceSubdivision para necesidades específicas de recursos legales locales."@es ;
                          rdfs:label "Extensión de Subdivisión de Recurso Legal"@es ,
                                     "Legal Resource Subdivision Extension"@en .


###  http://maia.madrid.es/ontologies/def/local-regulations#LegalValue
:LegalValue rdf:type owl:Class ;
            rdfs:subClassOf owl:Thing ,
                            [ rdf:type owl:Restriction ;
                              owl:onProperty :number ;
                              owl:cardinality "1"^^xsd:nonNegativeInteger
                            ] ,
                            [ rdf:type owl:Restriction ;
                              owl:onProperty :title ;
                              owl:cardinality "1"^^xsd:nonNegativeInteger
                            ] ;
            rdfs:comment "Specific value or status assigned within the legal framework, identified by a number and title."@en ,
                         "Valor o estado específico asignado dentro del marco legal, identificado por un número y título."@es ;
            rdfs:label "Legal Value"@en ,
                       "Valor Legal"@es .


###  http://maia.madrid.es/ontologies/def/local-regulations#Membership
:Membership rdf:type owl:Class ;
            rdfs:subClassOf <http://www.w3.org/ns/org#Membership> ;
            rdfs:comment "Extension of org:Membership for representing local public office assignments."@en ,
                         "Extensión de org:Membership para representar asignaciones de cargos públicos locales."@es ;
            rdfs:label "Membership"@en ,
                       "Membresía"@es .


###  http://maia.madrid.es/ontologies/def/local-regulations#Organization
:Organization rdf:type owl:Class ;
              rdfs:subClassOf <http://www.w3.org/ns/org#Organization> ;
              rdfs:comment "Organización involucrada en recursos legales (como aprobador, ejecutor, etc.)."@es ,
                           "Organization involved in legal resources (as approver, executor, etc.)."@en ;
              rdfs:label "Organización"@es ,
                         "Organization"@en .


###  http://maia.madrid.es/ontologies/def/local-regulations#Person
:Person rdf:type owl:Class ;
        rdfs:subClassOf <http://xmlns.com/foaf/0.1/Person> ;
        rdfs:comment "Natural person involved in legal resources (as author, approver, etc.)."@en ,
                     "Persona física involucrada en recursos legales (como autor, aprobador, etc.)."@es ;
        rdfs:label "Person"@en ,
                   "Persona"@es .


###  http://maia.madrid.es/ontologies/def/local-regulations#TopicPath
:TopicPath rdf:type owl:Class ;
           rdfs:comment "Hierarchical classification path that organizes topics or subject matters in a structured taxonomy."@en ,
                        "Ruta de clasificación jerárquica que organiza temas o materias en una taxonomía estructurada."@es ;
           rdfs:label "Ruta de Tema"@es ,
                      "Topic Path"@en .


###  http://maia.madrid.es/ontologies/def/local-regulations#TypeDocumentPath
:TypeDocumentPath rdf:type owl:Class ;
                  rdfs:subClassOf <http://data.europa.eu/eli/ontology#ResourceType> ,
                                  owl:Thing ;
                  rdfs:comment "Hierarchical classification path for document types in the legal domain."@en ,
                               "Ruta de clasificación jerárquica para tipos documentales en el ámbito legal."@es ;
                  rdfs:label "Ruta de Tipo Documental"@es ,
                             "Type Document Path"@en .


###  http://schema.org/Event
<http://schema.org/Event> rdf:type owl:Class ;
                          rdfs:comment "An event or occurrence related to legal processes or administrative actions."@en ,
                                       "Un evento u ocurrencia relacionado con procesos legales o acciones administrativas."@es ;
                          rdfs:label "Event"@en ,
                                     "Evento"@es .


###  http://www.w3.org/2006/time#Interval
<http://www.w3.org/2006/time#Interval> rdf:type owl:Class ;
                                       rdfs:subClassOf owl:Thing ,
                                                       [ rdf:type owl:Restriction ;
                                                         owl:onProperty <http://www.w3.org/2006/time#hasBeginning> ;
                                                         owl:cardinality "1"^^xsd:nonNegativeInteger
                                                       ] ,
                                                       [ rdf:type owl:Restriction ;
                                                         owl:onProperty <http://www.w3.org/2006/time#hasEnd> ;
                                                         owl:cardinality "1"^^xsd:nonNegativeInteger
                                                       ] ;
                                       rdfs:comment "A temporal interval with a defined beginning and end, used to represent periods of validity or office terms."@en ,
                                                    "Un intervalo temporal con un inicio y fin definidos, usado para representar periodos de vigencia o mandatos."@es ;
                                       rdfs:label "Intervalo Temporal"@es ,
                                                  "Time Interval"@en .


###  http://www.w3.org/2008/05/skos#Collection
<http://www.w3.org/2008/05/skos#Collection> rdf:type owl:Class ;
                                            rdfs:subClassOf owl:Thing ,
                                                            [ rdf:type owl:Restriction ;
                                                              owl:onProperty <http://purl.org/dc/elements/1.1/source> ;
                                                              owl:cardinality "1"^^xsd:nonNegativeInteger
                                                            ] ,
                                                            [ rdf:type owl:Restriction ;
                                                              owl:onProperty <http://www.w3.org/2008/05/skos#scopeNote> ;
                                                              owl:cardinality "1"^^xsd:nonNegativeInteger
                                                            ] ;
                                            rdfs:comment "A meaningful collection of concepts, used for grouping related concepts in a taxonomy."@en ,
                                                         "Una colección significativa de conceptos, usada para agrupar conceptos relacionados en una taxonomía."@es ;
                                            rdfs:label "Colección (SKOS)"@es ,
                                                       "Collection (SKOS)"@en .


###  http://www.w3.org/2008/05/skos#Concept
<http://www.w3.org/2008/05/skos#Concept> rdf:type owl:Class ;
                                         rdfs:subClassOf owl:Thing ,
                                                         [ rdf:type owl:Restriction ;
                                                           owl:onProperty <http://www.w3.org/2008/05/skos#broader> ;
                                                           owl:maxCardinality "1"^^xsd:nonNegativeInteger
                                                         ] ,
                                                         [ rdf:type owl:Restriction ;
                                                           owl:onProperty <http://www.w3.org/2008/05/skos#prefLabel> ;
                                                           owl:cardinality "1"^^xsd:nonNegativeInteger
                                                         ] ,
                                                         [ rdf:type owl:Restriction ;
                                                           owl:onProperty <http://www.w3.org/2008/05/skos#symbol> ;
                                                           owl:cardinality "1"^^xsd:nonNegativeInteger
                                                         ] ;
                                         rdfs:comment "An idea or notion; a unit of thought in a knowledge organization system."@en ,
                                                      "Una idea o noción; una unidad de pensamiento en un sistema de organización del conocimiento."@es ;
                                         rdfs:label "Concept (SKOS)"@en ,
                                                    "Concepto (SKOS)"@es .


###  http://www.w3.org/ns/org#Membership
<http://www.w3.org/ns/org#Membership> rdf:type owl:Class ;
                                      rdfs:comment "N-ary relation between a person, a public role and a public institution during a given term of office in a local government."@en ,
                                                   "Relación n-aria entre una persona, un rol público y una institución pública durante un periodo de ejercicio de un cargo en un gobierno local."@es ;
                                      rdfs:label "Cargo público"@es ,
                                                 "Public office"@en .


###  http://www.w3.org/ns/org#Organization
<http://www.w3.org/ns/org#Organization> rdf:type owl:Class ;
                                        rdfs:subClassOf <http://xmlns.com/foaf/0.1/Agent> ;
                                        rdfs:comment "A collection of people organized together into a community or other social, commercial or political structure."@en ,
                                                     "Un conjunto de personas organizadas en una comunidad u otra estructura social, comercial o política."@es ;
                                        rdfs:label "Organización (W3C org)"@es ,
                                                   "Organization (W3C org)"@en .


###  http://www.w3.org/ns/org#Role
<http://www.w3.org/ns/org#Role> rdf:type owl:Class ;
                                rdfs:comment "A role that an agent can hold in an organization, representing a position or function within the organizational structure."@en ,
                                             "Un rol que un agente puede desempeñar en una organización, representando una posición o función dentro de la estructura organizativa."@es ;
                                rdfs:label "Rol (W3C org)"@es ,
                                           "Role (W3C org)"@en .


###  http://xmlns.com/foaf/0.1/Agent
<http://xmlns.com/foaf/0.1/Agent> rdf:type owl:Class ;
                                  rdfs:comment "An agent (person, group, software or physical artifact) in the context of legal resources and organizational structures."@en ,
                                               "Un agente (persona, grupo, software o artefacto físico) en el contexto de recursos legales y estructuras organizativas."@es ;
                                  rdfs:label "Agent (FOAF)"@en ,
                                             "Agente (FOAF)"@es .


###  http://xmlns.com/foaf/0.1/Person
<http://xmlns.com/foaf/0.1/Person> rdf:type owl:Class ;
                                   rdfs:subClassOf <http://xmlns.com/foaf/0.1/Agent> ;
                                   rdfs:comment "A person, representing an individual human being in the context of legal resources and public administration."@en ,
                                                "Una persona, que representa un individuo humano en el contexto de recursos legales y administración pública."@es ;
                                   rdfs:label "Person (ELI)"@en ,
                                              "Persona (FOAF)"@es .


###  https://www.geonames.org/ontology#Feature
