                                            rdfs:comment "A geographical feature from the GeoNames ontology, representing a location or place."@en ,
                                                         "Una entidad geográfica de la ontología GeoNames, que representa una ubicación o lugar."@es ;
                                            rdfs:label "Entidad (GeoNames)"@es ,
