# ============================================================================
# loro-fuseki — environment variables (template)
# ============================================================================
#
# This file is a TEMPLATE. Copy it to `.env` and adjust as needed:
#
#     cp .env.example .env
#
# `.env` is git-ignored. Never commit credentials.
# ============================================================================

# Local TCP port exposed by Docker Compose
FUSEKI_LOCAL_PORT=3030

# Internal container port — leave as 8080 unless you have a reason to change it
PORT=8080

# JVM memory tuning. Quote when the value contains spaces.
JVM_ARGS="-Xmx4g -Xms1g"

# Disable write endpoints (SPARQL Update / GSP write) when set to "true"
FUSEKI_READONLY=false

# Auto-load TTL files from /staging into Fuseki on first start
LOAD_DATA_ON_START=true

# ----------------------------------------------------------------------------
# Authentication (Apache Shiro, three-role IAM model)
# ----------------------------------------------------------------------------
#
# - iacbx_admin : full access (UI, admin API, write, read).  REQUIRED.
# - iacbx_app   : write + read (SPARQL Update, GSP write).   Optional.
# - iacbx_read  : read only (SPARQL query, GSP read).        Optional.
#
# Roles whose password is empty are not provisioned at all.
# ----------------------------------------------------------------------------

IACBX_ADMIN_PASSWORD=admin
IACBX_APP_PASSWORD=
IACBX_READ_PASSWORD=
